# Verifier-service base URL (the Rust verifier-service, ZK path enabled)
VITE_VERIFIER_URL=http://localhost:3000
# Verifier client mode: "service" (current /zk/ endpoints) or "relay" (planned blind-relay endpoints)
VITE_VERIFIER_MODE=service
# Bridge: verifies the wallet session signature, proves, sends attestWithProof with the operator key. Defaults to VITE_VERIFIER_URL.
VITE_BRIDGE_URL=

# Sepolia contract addresses
VITE_REGISTRY=0x0000000000000000000000000000000000000000
VITE_FUND_TOKEN=0x0000000000000000000000000000000000000000
VITE_SUBSCRIPTION=0x0000000000000000000000000000000000000000
# Optional: Uniswap permissioned pool (WP7). Swap door stays disabled until set.
VITE_POOL=

# Demo policy
# Default when empty: keccak256("nachweis.pid.over18.v1")
VITE_POLICY_ID=0xd27260f1ca509ba75dea6cd27b2985a96e423550e16db3350d2945e215e3d05f
# Bits the issuer sets on approval and the doors require (1 = identity evidence, 2 = over 18)
VITE_REQUIRED_BITS=3

# Optional Sepolia RPC (defaults to viem's public endpoint)
VITE_RPC_URL=

# 1 = whole flow in memory with fake delays, no verifier and no chain
VITE_MOCK=0
