# Verifier-service base URL (the Rust verifier-service, ZK path enabled)
VITE_VERIFIER_URL=http://localhost:3000
# Verifier client mode: "service" (current /zk/ endpoints) or "relay" (planned blind-relay endpoints)
VITE_VERIFIER_MODE=service
# Bridge: creates the session (POST /sessions), verifies the wallet session signature, proves, sends attestWithProof with the operator key.
# Set in every real-mode run. Unset: the app calls the verifier directly (VITE_VERIFIER_MODE) and tries the bridge endpoints at VITE_VERIFIER_URL.
VITE_BRIDGE_URL=

# Sepolia contract addresses
VITE_REGISTRY=0x0000000000000000000000000000000000000000
VITE_FUND_TOKEN=0x0000000000000000000000000000000000000000
VITE_SUBSCRIPTION=0x0000000000000000000000000000000000000000
# Optional: Uniswap permissioned pool (WP7). Swap door stays disabled until set.
VITE_POOL_ADAPTER=
VITE_POOL_STABLE=
# VITE_POOL_FEE=3000
# VITE_POOL_TICK_SPACING=60
# VITE_POOL=

# Demo policy
# Default when empty: keccak256("nachweis.pid.over18.v1")
VITE_POLICY_ID=0xd27260f1ca509ba75dea6cd27b2985a96e423550e16db3350d2945e215e3d05f
# Bits the issuer sets on approval and the doors require (1 = identity evidence, 2 = over 18)
VITE_REQUIRED_BITS=3

# Chain the wallet must be on: 11155111 = Sepolia (default), 31337 = plain anvil
VITE_CHAIN_ID=11155111
# Optional RPC. Sepolia: defaults to viem's public endpoint. Anvil: defaults to http://127.0.0.1:8545
VITE_RPC_URL=

# 1 = whole flow in memory with fake delays, no verifier and no chain
VITE_MOCK=0

# Privy (optional, docs/privy-standing-order.md). Unset: the wallet layer is unchanged and no standing-order card is shown.
# App id of the builder's Privy app "Attestat" (development mode, created 2026-09-09; a public identifier, not a secret).
# Set it and the investor gets "Sign in with email, wallet by Privy"; the operator then connects through Privy's
# wallet picker (the dev signer is not available while it is set). Allowed origins on that app: http://localhost:5173
# (bun run dev) and http://localhost:4173 (vite preview); the stack scripts pick free ports, so use APP_PORT=5173 with them.
VITE_PRIVY_APP_ID=cmttciu77003c0bjv4xvdmupe
# Key quorum id of the issuer's authorization key "attestat-automation" (Dashboard, Keys and quorums; a public identifier): the signer the investor allows.
VITE_PRIVY_SIGNER_ID=m1x3z2i6n7fdtus1apxa84ww
# The issuer's automation (automation/, `bun run src/server.ts`): standing-order card and the issuer's automation log read it.
VITE_AUTOMATION_URL=http://127.0.0.1:8790

# zkPassport route (WP33, optional second evidence route). 1 renders the "Passport chip (zkPassport)" card.
# The other values must equal the deployed ZkPassportVerifier's immutables (domain, scope, dev mode, validity, decision ttl).
VITE_ZKPASSPORT=0
VITE_ZKPASSPORT_DOMAIN=
VITE_ZKPASSPORT_SCOPE=attestat-over18
VITE_ZKPASSPORT_DEV_MODE=0
VITE_ZKPASSPORT_VALIDITY=604800
VITE_ZKPASSPORT_DECISION_TTL=2592000

# Showcase demos (/showcase/<slug>, src/showcase/registry.ts). Compliance desk service URL (showcase/backoffice); default http://127.0.0.1:8794
VITE_BACKOFFICE_URL=
