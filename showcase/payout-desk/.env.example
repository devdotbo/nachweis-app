# Contractor payout desk service (docs/showcase/payout-desk.md). Copy to showcase/payout-desk/.env (gitignored).

# privy: the treasury is a Privy server wallet; Privy's policy engine decides every signing request in the TEE
#        before the service broadcasts the signed transaction. Needs the PRIVY_* values and a Sepolia RPC.
# local: the treasury is LOCAL_TREASURY_KEY on anvil; the same rule JSON is applied by a small evaluator in
#        src/policy.ts, captioned "simulated Privy policy (local)". Dev loop only, never in the video.
PAYOUT_SIGNER=local

# Privy app "Attestat" (development mode). The app id, wallet id, policy id and key quorum id are public identifiers
# and may stay in this file; the app secret and the officers' authorization private keys never go into a tracked file.
PRIVY_APP_ID=cmttciu77003c0bjv4xvdmupe
PRIVY_APP_SECRET=
# Treasury wallet, policy and owner quorum as created by `bun run setup` (ids only).
PRIVY_WALLET_ID=
PRIVY_POLICY_ID=
PRIVY_KEY_QUORUM_ID=
# Officer A: the private key of the authorization key "attestat-automation" (base64 PKCS8, "wallet-auth:" prefix optional).
PRIVY_AUTHORIZATION_KEY=
# Officer B: second authorization key. Set: every signing request carries both keys (2-of-2 key quorum).
# Unset: 1-of-1 quorum, the second approval is recorded by this service (captioned).
PRIVY_AUTHORIZATION_KEY_B=

# Chain. Sepolia for privy mode; anvil for local mode.
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
REGISTRY=0x0000000000000000000000000000000000000000
GATED_PAYOUT=0x0000000000000000000000000000000000000000
PAYOUT_TOKEN=0x0000000000000000000000000000000000000000
# Default when empty: keccak256("nachweis.pid.over18.v1")
POLICY_ID=
REQUIRED_BITS=3
# Per-run cap the policy enforces, in token units (6 decimals): 1000 mUSD.
PAYOUT_CAP=1000000000

# local mode only: the treasury's private key (anvil key 3 by default).
LOCAL_TREASURY_KEY=0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6

# Officer bearer tokens (the company screen sends one of them). Defaults: officer-a, officer-b.
OFFICER_A_TOKEN=officer-a
OFFICER_B_TOKEN=officer-b
# Seed contractors, comma separated "label:address". The screen can add more.
CONTRACTORS=

# HTTP server
PORT=8791
