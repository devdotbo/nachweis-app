# Copy to .env (bun loads it) or export in the shell. No secret values here.

# local (anvil dev key, quorum and policy simulated in memory) or privy (Privy server wallet, TEE enforces both)
BACKOFFICE_MODE=local
# JSON-RPC endpoint of the chain the registry lives on
RPC_URL=http://127.0.0.1:8545
# chain id; defaults to 31337 in local mode and 11155111 in privy mode
CHAIN_ID=31337
# AttestationRegistry address (required)
REGISTRY=0x5FbDB2315678afecb367f032d93F642f64180aa3
# fund token address; the transfer probe targets it when set, else a burn address
FUND_TOKEN=
# policy id (bytes32); defaults to keccak256("nachweis.pid.over18.v1")
POLICY_ID=
# first block the watcher reads; defaults to 0 in local mode and to the current head in privy mode
START_BLOCK=
# watcher poll interval in milliseconds
POLL_MS=3000
# HTTP port of the desk
PORT=8794

# local mode: the operator's private key; defaults to anvil account 3
OPERATOR_PRIVATE_KEY=

# privy mode: app credentials (export them in the shell; bootstrap never writes them to .env)
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# privy mode: the compliance officer's P-256 authorization private key (base64 PKCS8, "wallet-auth:" prefix optional)
PRIVY_COMPLIANCE_KEY=
# privy mode: the operations officer's P-256 authorization private key
PRIVY_OPERATIONS_KEY=
# privy mode: the operator server wallet id
PRIVY_OPERATOR_WALLET_ID=
# privy mode: the operator server wallet address
PRIVY_OPERATOR_ADDRESS=
# privy mode: the policy id bound to the wallet (shown on the desk)
PRIVY_POLICY_ID=
# privy mode: the 2-of-2 key quorum id (display only)
PRIVY_QUORUM_ID=
