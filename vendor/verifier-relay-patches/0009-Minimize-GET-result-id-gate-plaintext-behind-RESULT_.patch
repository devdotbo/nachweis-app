-/// The outcome of a default-path session, with the presentation.
+/// Gate on `GET /result/:id`: the shared secret between the verifier and the
+/// bridge.
+///
+/// With `RESULT_TOKEN` set, every read must carry it in `X-Result-Token`
+/// (401 otherwise). Without it, the endpoint serves the minimized summary
+/// only; if the operator also turned on a plaintext flag
+/// (`RESULT_INCLUDES_PRESENTATION`, `RESULT_INCLUDES_NAMES`), the endpoint
+/// refuses with 503 rather than hand plaintext to an unauthenticated caller.
+fn require_result_token(state: &AppState, headers: &axum::http::HeaderMap) -> Result<(), AppError> {
+    let plaintext = state.result_includes_presentation || state.result_includes_names;
+    match state.result_token.as_deref() {
+        None if plaintext => Err(AppError::Unavailable(
+            "RESULT_TOKEN is not set: GET /result/:id refuses to serve plaintext while \
+             RESULT_INCLUDES_PRESENTATION or RESULT_INCLUDES_NAMES is on; set RESULT_TOKEN \
+             (the bridge sends it as X-Result-Token) or turn both flags off"
+                .into(),
+        )),
+        None => Ok(()),
+        Some(expected) => {
+            let presented = headers
+                .get("x-result-token")
+                .and_then(|v| v.to_str().ok())
+                .ok_or_else(|| {
+                    AppError::Unauthorized("X-Result-Token header missing".into())
+                })?;
+            if crate::relay::tokens_match(expected, presented) {
+                Ok(())
+            } else {
+                Err(AppError::Unauthorized("X-Result-Token does not match".into()))
+            }
+        }
+    }
+}
