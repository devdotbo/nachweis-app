+    assert!(status.is_success(), "{status} {answer}");
+    assert_no_plaintext(&answer, "the relay answer to the wallet");
+
+    for (status, body) in [
+        get_json(&router, &format!("/result/{session}")).await,
+        get_json_with_token(&router, &format!("/result/{session}"), TOKEN).await,
+        get_json(&router, &format!("/relay/status/{session}")).await,
+    ] {
+        assert_no_plaintext(&body, "a relay session read");
+        assert_ne!(body["status"], "verified", "{status} {body}");
+    }
+    let (status, _) = get_json_with_token(&router, &format!("/result/{session}"), TOKEN).await;
+    assert_eq!(status, StatusCode::NOT_FOUND);
+}
