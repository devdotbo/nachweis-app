+    /// Drop every session created `ttl_secs` or more before `now` and return
+    /// their ids, so the caller can drop the matching outcomes too. Called from
+    /// `POST /request`, the one place the table grows.
+    pub async fn prune_expired(&self, now: i64) -> Vec<Uuid> {
+        let mut sessions = self.sessions.lock().await;
+        let expired: Vec<Uuid> = sessions
+            .iter()
+            .filter(|(_, s)| now - s.created_at >= self.ttl_secs)
+            .map(|(id, _)| *id)
+            .collect();
+        for id in &expired {
+            sessions.remove(id);
+        }
+        expired
+    }
+
+    pub async fn pending_count(&self) -> usize {
+        self.sessions
+            .lock()
+            .await
+            .values()
+            .filter(|s| !s.completed)
+            .count()
+    }
