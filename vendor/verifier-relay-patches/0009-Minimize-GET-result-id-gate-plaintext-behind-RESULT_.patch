+                "y": "2BJYVUDsqw2xoD4tB3o7QeIIdd89wQ82oTTrDy8H8Bs",
+            },
+            "bound_address": "0xd8dA6BF26964aF9D7eEd9e03E53415D37aA96045",
+            "challenge": "0x00112233445566778899aabbccddeeff",
+        }),
+    )
+    .await;
+    assert_eq!(status, StatusCode::CREATED, "{created}");
+    let session = created["session_id"].as_str().unwrap().to_string();
+
+    // Answer it the way a wallet does. The service cannot decrypt it (the key
+    // is the client's), so this is a stored ciphertext, not an outcome.
+    let payload = request_object_payload(&router, &session).await;
+    let aud = payload["client_id"].as_str().unwrap();
+    let nonce = payload["nonce"].as_str().unwrap();
+    let query_id = payload["dcql_query"]["credentials"][0]["id"]
+        .as_str()
+        .unwrap();
+    let presentation = mint_presentation(nonce, aud, now_unix());
+    let jwe = encrypt_to(
