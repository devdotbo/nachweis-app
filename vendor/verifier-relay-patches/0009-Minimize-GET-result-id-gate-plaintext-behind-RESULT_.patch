+#[tokio::test]
+async fn pending_sessions_are_capped() {
+    let router = app_with(Knobs {
+        max_pending: Some(2),
+        ..Knobs::default()
+    })
+    .await;
+    let (status, first) = post_json(&router, "/request", json!({ "nonce": NONCE })).await;
+    assert_eq!(status, StatusCode::CREATED, "{first}");
+    let (status, _) = post_json(&router, "/request", json!({ "nonce": NONCE_2 })).await;
+    assert_eq!(status, StatusCode::CREATED);
+    let third = "a".repeat(32);
+    let (status, body) = post_json(&router, "/request", json!({ "nonce": third })).await;
+    assert_eq!(status, StatusCode::TOO_MANY_REQUESTS, "{body}");
+    assert!(body["error"].as_str().unwrap().contains("BRIDGE_MAX_PENDING"));
+
+    // Completing one frees a slot.
+    let session = first["session_id"].as_str().unwrap().to_string();
+    let (_, status, _) = answer_as_wallet(&router, &session, None).await;
+    assert_eq!(status, StatusCode::OK);
+    let (status, body) = post_json(&router, "/request", json!({ "nonce": third })).await;
+    assert_eq!(status, StatusCode::CREATED, "{body}");
+}
+
+#[tokio::test]
+async fn expired_sessions_are_dropped_with_their_outcome() {
+    // TTL 0: every session is expired by the next `POST /request`.
+    let router = app_with(Knobs {
+        ttl_secs: Some(0),
+        ..Knobs::default()
+    })
+    .await;
+    let (_, created) = post_json(&router, "/request", json!({ "nonce": NONCE })).await;
+    let session = created["session_id"].as_str().unwrap().to_string();
+    let (_, status, _) = answer_as_wallet(&router, &session, None).await;
+    assert_eq!(status, StatusCode::OK);
+    let (status, result) = get_json(&router, &format!("/result/{session}")).await;
+    assert_eq!(status, StatusCode::OK);
+    assert_eq!(result["status"], "verified");
+
+    let (status, _) = post_json(&router, "/request", json!({ "nonce": NONCE_2 })).await;
+    assert_eq!(status, StatusCode::CREATED);
+    let (status, _) = get_json(&router, &format!("/result/{session}")).await;
+    assert_eq!(status, StatusCode::NOT_FOUND, "the outcome went with the session");
+    // The pruned session's nonce is free (it was completed anyway); a pending
+    // one is pruned the same way.
+    let (status, pending) = post_json(&router, "/request", json!({ "nonce": NONCE })).await;
+    assert_eq!(status, StatusCode::CREATED);
+    let pending = pending["session_id"].as_str().unwrap().to_string();
+    let (status, _) = post_json(&router, "/request", json!({ "nonce": NONCE })).await;
+    assert_eq!(status, StatusCode::CREATED, "the pending session expired first");
+    let (status, _) = get_json(&router, &format!("/result/{pending}")).await;
+    assert_eq!(status, StatusCode::NOT_FOUND);
 }
 
