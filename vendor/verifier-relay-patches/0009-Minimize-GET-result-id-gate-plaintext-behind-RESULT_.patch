+    #[tokio::test]
+    async fn the_pending_cap_counts_pending_sessions_only() {
+        let bridge = BridgeState {
+            max_pending: 2,
+            ..BridgeState::default()
+        };
+        let first = Uuid::new_v4();
+        bridge.claim(first, session("n1")).await.unwrap();
+        bridge.claim(Uuid::new_v4(), session("n2")).await.unwrap();
+        assert_eq!(
+            bridge.claim(Uuid::new_v4(), session("n3")).await.unwrap_err(),
+            ClaimError::PendingCapReached { max: 2 }
+        );
+        assert_eq!(bridge.pending_count().await, 2);
+        bridge.complete(first).await.unwrap();
+        bridge.claim(Uuid::new_v4(), session("n3")).await.unwrap();
+        assert_eq!(bridge.pending_count().await, 2);
+    }
+
+    #[tokio::test]
+    async fn expired_sessions_are_pruned_pending_or_not() {
+        let bridge = BridgeState {
+            ttl_secs: 100,
+            ..BridgeState::default()
+        };
+        let old_pending = Uuid::new_v4();
+        let old_done = Uuid::new_v4();
+        let fresh = Uuid::new_v4();
+        bridge.claim(old_pending, session("n1")).await.unwrap();
+        bridge.claim(old_done, session("n2")).await.unwrap();
+        bridge.complete(old_done).await.unwrap();
+        let mut s = session("n3");
+        s.created_at = 50;
+        bridge.claim(fresh, s).await.unwrap();
+
+        assert!(bridge.prune_expired(99).await.is_empty());
+        let mut pruned = bridge.prune_expired(100).await;
+        pruned.sort();
+        let mut expected = vec![old_pending, old_done];
+        expected.sort();
+        assert_eq!(pruned, expected);
+        assert!(!bridge.is_bridge_session(old_pending).await);
+        assert!(bridge.is_bridge_session(fresh).await);
+        // The pruned nonce is free again.
+        bridge.claim(Uuid::new_v4(), session("n1")).await.unwrap();
+    }
+
+    fn verified(disclosed: Vec<(Vec<&str>, Value)>, exp: Option<i64>) -> VerifiedPid {
+        use verifier_core::disclosure::{DisclosedClaim, RevealedView};
+        let mut claims = serde_json::json!({
+            "iss": "https://issuer.example",
+            "vct": "urn:eudi:pid:de:1",
+            "given_name": "Erika",
+            "family_name": "Mustermann",
+            "age_equal_or_over": { "18": true }
+        });
+        if let Some(exp) = exp {
+            claims["exp"] = Value::from(exp);
+        }
+        VerifiedPid {
+            vct: "urn:eudi:pid:de:1".into(),
+            view: RevealedView {
+                claims,
+                disclosed: disclosed
+                    .into_iter()
+                    .map(|(path, value)| DisclosedClaim {
+                        path: path.into_iter().map(String::from).collect(),
+                        value,
+                    })
+                    .collect(),
+            },
+            status_ref: None,
+            holder_bound: true,
+        }
+    }
+
+    #[test]
+    fn the_summary_carries_predicates_and_paths_but_no_disclosed_value() {
+        let pid = verified(
+            vec![
+                (vec!["age_equal_or_over", "18"], Value::Bool(true)),
+                (vec!["family_name"], Value::from("Mustermann")),
+                (vec!["given_name"], Value::from("Erika")),
+            ],
+            Some(1_900_000_000),
+        );
+        let summary = ResultSummary::from_verified(&pid);
+        let json = serde_json::to_string(&summary).unwrap();
+        assert!(!json.contains("Erika"), "{json}");
+        assert!(!json.contains("Mustermann"), "{json}");
+        assert!(!json.contains("issuer.example"), "{json}");
+        assert_eq!(summary.age_equal_or_over.unwrap()["18"], Value::Bool(true));
+        assert_eq!(summary.credential_exp, Some(1_900_000_000));
+        assert!(summary.nonce_bound && summary.holder_bound);
+        assert_eq!(
+            summary.disclosed_paths,
+            vec!["age_equal_or_over.18", "family_name", "given_name"]
+        );
+    }
+
+    #[test]
+    fn the_summary_reads_a_whole_age_object_and_ignores_non_booleans() {
+        let pid = verified(
+            vec![(
+                vec!["age_equal_or_over"],
+                serde_json::json!({ "18": true, "65": false, "note": "Erika" }),
+            )],
+            None,
+        );
+        let summary = ResultSummary::from_verified(&pid);
+        let age = summary.age_equal_or_over.unwrap();
+        assert_eq!(age.len(), 2);
+        assert_eq!(age["18"], Value::Bool(true));
+        assert_eq!(age["65"], Value::Bool(false));
+        assert_eq!(summary.credential_exp, None);
+
+        let none = ResultSummary::from_verified(&verified(vec![], None));
+        assert_eq!(none.age_equal_or_over, None);
+        assert!(none.disclosed_paths.is_empty());
+    }
+
