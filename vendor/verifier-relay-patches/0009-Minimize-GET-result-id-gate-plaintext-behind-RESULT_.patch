     /// Register a session under its nonce. Refused when a PENDING session
     /// already carries the same nonce: two live requests with one nonce would
     /// let a single presentation answer either of them.
@@ -104,6 +229,12 @@ impl BridgeState {
         {
             return Err(ClaimError::NonceInUse { session_id: *other });
