+/// Default cap on sessions created through `POST /request` that still wait for
+/// their wallet response. `BRIDGE_MAX_PENDING` overrides it.
+pub const DEFAULT_MAX_PENDING: usize = 1000;
+/// Default lifetime of a bridge session, pending or completed, measured from
+/// its creation. `BRIDGE_SESSION_TTL_SECS` overrides it. Longer than the
+/// bridge's own 10-minute poll timeout, so a slow wallet still gets its result
+/// read before the session is dropped.
+pub const DEFAULT_SESSION_TTL_SECS: i64 = 900;
+
+/// What `GET /result/:id` reports about a verified session by default: the
+/// outcome of every check and the predicate the request asked for, and no
+/// disclosed string value. Names (`given_name`, `family_name`) and the raw
+/// presentation are behind explicit flags and the result token, see
+/// `docs/bridge-mode.md`.
+///
+/// Built once, at verification time, from the parsed presentation; only
+/// booleans, integers and claim PATHS are copied out of the disclosed view, so
+/// no value the wallet disclosed can reach this struct by accident.
+#[derive(Debug, Clone, PartialEq, Eq, serde::Serialize)]
+pub struct ResultSummary {
+    /// The credential type the request asked for and the presentation carried.
+    pub vct: String,
+    /// The KB-JWT was present and verified against the `cnf` key.
+    pub holder_bound: bool,
+    /// The KB-JWT `nonce` matched the request's nonce. Verification rejects a
+    /// mismatch, so this is `true` for every verified session; it is stated so
+    /// a consumer does not have to know that.
+    pub nonce_bound: bool,
+    /// The disclosed `age_equal_or_over` predicates, e.g. `{"18": true}`. Only
+    /// boolean values are copied; absent when the wallet disclosed none.
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub age_equal_or_over: Option<Map<String, Value>>,
+    /// The issuer JWT `exp`, unix seconds, when the credential has one.
+    /// Verification rejects an expired credential, so a verified session's
+    /// value lies in the future at verification time.
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub credential_exp: Option<i64>,
+    /// Dotted paths of the disclosed claims (`given_name`,
+    /// `age_equal_or_over.18`, ...): which claims the wallet revealed, never
+    /// what they said.
+    pub disclosed_paths: Vec<String>,
+}
+
+impl ResultSummary {
+    pub fn from_verified(pid: &VerifiedPid) -> Self {
+        let mut age: Map<String, Value> = Map::new();
+        for claim in &pid.view.disclosed {
+            match claim.path.as_slice() {
+                // A nested disclosure: `age_equal_or_over.18 = true`.
+                [root, bound] if root == "age_equal_or_over" => {
+                    if let Value::Bool(b) = claim.value {
+                        age.insert(bound.clone(), Value::Bool(b));
+                    }
+                }
+                // The whole object disclosed at once: `{"18": true, "65": false}`.
+                [root] if root == "age_equal_or_over" => {
+                    if let Value::Object(map) = &claim.value {
+                        for (bound, v) in map {
+                            if let Value::Bool(b) = v {
+                                age.insert(bound.clone(), Value::Bool(*b));
+                            }
+                        }
+                    }
+                }
+                _ => {}
+            }
+        }
+        Self {
+            vct: pid.vct.clone(),
+            holder_bound: pid.holder_bound,
+            nonce_bound: true,
+            age_equal_or_over: (!age.is_empty()).then_some(age),
+            credential_exp: pid.view.claims.get("exp").and_then(Value::as_i64),
+            disclosed_paths: pid.view.disclosed.iter().map(|d| d.key()).collect(),
+        }
+    }
+}
