+++ b/verifier-service/src/bridge.rs
@@ -0,0 +1,214 @@
+//! Verifier mode for the Nachweis bridge: a caller-supplied nonce in, the
+//! verified presentation out.
+//!
+//! In this mode the bridge (a service on the same host) decides the nonce,
+//! because it has to be `sha256(address || challenge)` for the on-chain
+//! binding, and it needs the raw SD-JWT presentation afterwards to prove the
+//! statement in the zkVM. The verifier still does everything it does on the
+//! default path (decrypt, verify the signatures, trust-anchor the issuer, check
+//! freshness and binding); the two additions are read-side. See
+//! `docs/bridge-mode.md`.
+//!
+//! What this module owns: nonce validation and the bridge session table (which
+//! sessions were created with a caller nonce, and which nonces are still in
+//! flight). The HTTP handlers live in `handlers.rs`, beside the default path.
+//!
+//! The privacy trade is stated plainly: on this path the verifier holds the
+//! decrypted presentation in memory and hands it to the bridge. The blind relay
+//! (`crate::relay`) is the alternative where the server never can.
+
+use std::collections::HashMap;
+
+use tokio::sync::Mutex;
+use uuid::Uuid;
+
+/// Shortest nonce accepted. A 16-character token from the allowed alphabet is
+/// about 96 bits, the floor for replay protection to mean anything.
+pub const MIN_NONCE_LEN: usize = 16;
+/// Longest nonce accepted. The nonce is copied into the signed request object
+/// and into the wallet's KB-JWT; a bound keeps both small.
+pub const MAX_NONCE_LEN: usize = 128;
+
+/// Validate a caller-supplied nonce: 16 to 128 characters of `[A-Za-z0-9_-]`.
+///
+/// This alphabet covers the two formats callers actually send (lowercase hex
+/// from the bridge, base64url or a UUID from anything else) and nothing that
+/// needs escaping in a URL, a form body or a JSON string.
+pub fn validate_nonce(nonce: &str) -> Result<(), String> {
+    let len = nonce.chars().count();
+    if len < MIN_NONCE_LEN {
+        return Err(format!(
+            "nonce must be at least {MIN_NONCE_LEN} characters, got {len}"
+        ));
+    }
+    if len > MAX_NONCE_LEN {
+        return Err(format!(
+            "nonce must be at most {MAX_NONCE_LEN} characters, got {len}"
+        ));
+    }
+    if let Some(bad) = nonce
+        .chars()
+        .find(|c| !(c.is_ascii_alphanumeric() || *c == '_' || *c == '-'))
+    {
+        return Err(format!(
+            "nonce may only contain A-Z, a-z, 0-9, '_' and '-'; found {bad:?}"
+        ));
+    }
+    Ok(())
+}
+
+/// One session created through `POST /request`.
+#[derive(Debug, Clone)]
+pub struct BridgeSession {
+    pub nonce: String,
+    /// Where the wallet should send the user afterwards (same-device flow), if
+    /// the caller asked for one. Returned verbatim in the answer to the
+    /// wallet's POST.
+    pub redirect_uri: Option<String>,
+    pub created_at: i64,
+    /// Set once the wallet's response has been verified or rejected. A
+    /// completed session no longer reserves its nonce.
+    pub completed: bool,
+}
+
+/// Why a session could not be claimed.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum ClaimError {
+    /// Another session with this nonce is still waiting for its wallet
+    /// response. Mapped to 409 in `handlers.rs`.
+    NonceInUse { session_id: Uuid },
+}
+
+/// The bridge session table.
+#[derive(Debug, Default)]
+pub struct BridgeState {
+    sessions: Mutex<HashMap<Uuid, BridgeSession>>,
+}
+
+impl BridgeState {
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    /// Register a session under its nonce. Refused when a PENDING session
+    /// already carries the same nonce: two live requests with one nonce would
+    /// let a single presentation answer either of them.
+    ///
+    /// Check and insert happen under one lock, so two concurrent claims with the
+    /// same nonce cannot both succeed.
+    pub async fn claim(&self, id: Uuid, session: BridgeSession) -> Result<(), ClaimError> {
+        let mut sessions = self.sessions.lock().await;
+        if let Some((other, _)) = sessions
+            .iter()
+            .find(|(_, s)| !s.completed && s.nonce == session.nonce)
+        {
+            return Err(ClaimError::NonceInUse { session_id: *other });
+        }
+        sessions.insert(id, session);
+        Ok(())
+    }
+
+    pub async fn is_bridge_session(&self, id: Uuid) -> bool {
+        self.sessions.lock().await.contains_key(&id)
+    }
+
+    pub async fn get(&self, id: Uuid) -> Option<BridgeSession> {
+        self.sessions.lock().await.get(&id).cloned()
+    }
+
+    /// Mark a session complete (its nonce may be reused) and return its
+    /// redirect target, if one was registered. `None` for a session this table
+    /// does not know.
+    pub async fn complete(&self, id: Uuid) -> Option<Option<String>> {
+        let mut sessions = self.sessions.lock().await;
+        let session = sessions.get_mut(&id)?;
+        session.completed = true;
+        Some(session.redirect_uri.clone())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn nonce_accepts_hex_base64url_and_uuid_shapes() {
+        validate_nonce("538cc3ecfb6325d0f4adb5c784a8caac93bbac1cd69b10701b210ff8e66f84ab").unwrap();
+        validate_nonce("b4ba2623-76a2-486b-a1f6-f1656025d07b").unwrap();
+        validate_nonce("Qk9OQ0VfdG9rZW5fLTEyMzQ1Njc4OTA").unwrap();
+        validate_nonce("0123456789abcdef").unwrap();
+        validate_nonce(&"a".repeat(MAX_NONCE_LEN)).unwrap();
+    }
+
+    #[test]
+    fn nonce_rejects_short_long_and_out_of_alphabet() {
+        assert!(validate_nonce("").unwrap_err().contains("at least"));
+        assert!(validate_nonce("0123456789abcde")
+            .unwrap_err()
+            .contains("at least"));
+        assert!(validate_nonce(&"a".repeat(MAX_NONCE_LEN + 1))
+            .unwrap_err()
+            .contains("at most"));
+        for bad in [
+            "0123456789abcdef ",
+            "0123456789abcdef.",
+            "0123456789abcdef+",
+            "0123456789abcdef/",
+            "0123456789abcdef=",
+            "0123456789abcdefü",
+            "0x0123456789abcdef!",
+        ] {
+            assert!(
+                validate_nonce(bad)
+                    .unwrap_err()
+                    .contains("may only contain"),
+                "{bad:?} should be refused on alphabet"
+            );
+        }
+    }
+
+    fn session(nonce: &str) -> BridgeSession {
+        BridgeSession {
+            nonce: nonce.into(),
+            redirect_uri: None,
+            created_at: 0,
+            completed: false,
+        }
+    }
+
+    #[tokio::test]
+    async fn a_pending_nonce_cannot_be_claimed_twice_but_a_completed_one_can() {
+        let bridge = BridgeState::new();
+        let first = Uuid::new_v4();
+        bridge.claim(first, session("n1")).await.unwrap();
+        assert!(bridge.is_bridge_session(first).await);
+
+        let second = Uuid::new_v4();
+        assert_eq!(
+            bridge.claim(second, session("n1")).await.unwrap_err(),
+            ClaimError::NonceInUse { session_id: first }
+        );
+        assert!(!bridge.is_bridge_session(second).await);
+        bridge.claim(second, session("n2")).await.unwrap();
+
+        assert_eq!(bridge.complete(first).await, Some(None));
+        assert!(bridge.get(first).await.unwrap().completed);
+        let third = Uuid::new_v4();
+        bridge.claim(third, session("n1")).await.unwrap();
+
+        assert_eq!(bridge.complete(Uuid::new_v4()).await, None);
+    }
+
+    #[tokio::test]
+    async fn complete_returns_the_redirect_uri() {
+        let bridge = BridgeState::new();
+        let id = Uuid::new_v4();
+        let mut s = session("n1");
+        s.redirect_uri = Some("nachweis://return".into());
+        bridge.claim(id, s).await.unwrap();
+        assert_eq!(
+            bridge.complete(id).await,
+            Some(Some("nachweis://return".to_string()))
+        );
+    }
+}
