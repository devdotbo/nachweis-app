+// ---------------------------------------------------------------------------
+// verifier mode for the bridge
+// ---------------------------------------------------------------------------
+
+/// Body of `POST /request`.
+#[derive(serde::Deserialize)]
+pub struct BridgeRequestBody {
+    /// The nonce the signed request object carries and the wallet copies into
+    /// the KB-JWT: 16 to 128 characters of `[A-Za-z0-9_-]`. See
+    /// `bridge::validate_nonce`.
+    pub nonce: String,
+    /// Optional same-device return target. When set, the wallet's POST is
+    /// answered with `{"redirect_uri": "<this>"}` on a verified presentation.
+    #[serde(default)]
+    pub redirect_uri: Option<String>,
+}
+
+/// Create a default-path presentation request with the caller's nonce.
+///
+/// Everything else is the landing page's request: the registered minimal DCQL
+/// query, our own encryption key, `direct_post.jwt`. The session is remembered
+/// in the bridge table so `GET /result/:id` can say `pending` and so a second
+/// request with the same nonce is refused (409) while the first is in flight.
+async fn bridge_request(
+    State(state): State<Arc<AppState>>,
+    Json(body): Json<BridgeRequestBody>,
+) -> Result<(StatusCode, Json<Value>), AppError> {
+    crate::bridge::validate_nonce(&body.nonce).map_err(AppError::bad)?;
+    if let Some(uri) = body.redirect_uri.as_deref() {
+        url::Url::parse(uri)
+            .map_err(|e| AppError::bad(format!("redirect_uri must be an absolute URL: {e}")))?;
+    }
+
+    let (session_id, url) = create_request(&state, body.nonce.clone()).await?;
+    state
+        .bridge
+        .claim(
+            session_id,
+            crate::bridge::BridgeSession {
+                nonce: body.nonce.clone(),
+                redirect_uri: body.redirect_uri,
+                created_at: now_unix(),
+                completed: false,
+            },
+        )
+        .await
+        .map_err(|e| match e {
+            // The signed session built above is never handed out, so it is
+            // unreachable: nobody learns its id.
+            crate::bridge::ClaimError::NonceInUse { session_id } => AppError::Conflict(format!(
+                "nonce is already in use by pending session {session_id}"
+            )),
+        })?;
+
+    // `session` / `authorization_request` are the names the bridge client
+    // reads; `session_id` / `openid4vp_uri` match the relay endpoint.
+    Ok((
+        StatusCode::CREATED,
+        Json(serde_json::json!({
+            "session_id": session_id,
+            "session": session_id,
+            "request_uri": format!("{}request/{}", state.public_url, session_id),
+            "openid4vp_uri": url.to_string(),
+            "authorization_request": url.to_string(),
+            "nonce": body.nonce,
+            "result_url": format!("{}result/{}", state.public_url, session_id),
+        })),
+    ))
+}
+
+/// The outcome of a default-path session, with the presentation.
+///
+/// `pending` is only reported for sessions created through `POST /request`; a
+/// landing-page session with no outcome yet is 404 here, and relay or ZK
+/// sessions have their own endpoints. A verified outcome is served for any
+/// default-path session, so the two creation routes share one store.
+async fn bridge_result(
+    State(state): State<Arc<AppState>>,
+    Path(id): Path<String>,
+) -> Result<Json<Value>, AppError> {
+    let uuid: Uuid = id
+        .parse()
+        .map_err(|_| AppError::bad("invalid session id"))?;
+    let bridge_session = state.bridge.get(uuid).await;
+    let nonce = bridge_session.as_ref().map(|s| s.nonce.clone());
+    let results = state.results.lock().await;
+    match results.get(&uuid) {
+        Some(SessionResult::Verified { pid, presentation }) => {
+            let mut out = serde_json::json!({
+                "status": "verified",
+                "session_id": uuid,
+                "nonce": nonce,
+                "verified_pid": pid,
+            });
+            match presentation {
+                Some(p) => out["presentation"] = Value::from(p.as_str()),
+                None => {
+                    out["presentation_withheld"] = Value::from(
+                        "RESULT_INCLUDES_PRESENTATION=false: only the parsed summary is kept",
+                    )
+                }
+            }
+            Ok(Json(out))
+        }
+        Some(SessionResult::Rejected(reason)) => Ok(Json(serde_json::json!({
+            "status": "rejected",
+            "session_id": uuid,
+            "nonce": nonce,
+            "error": reason,
+            // The bridge client reads `reason`.
+            "reason": reason,
+        }))),
+        None if bridge_session.is_some() => Ok(Json(serde_json::json!({
+            "status": "pending",
+            "session_id": uuid,
+            "nonce": nonce,
+        }))),
+        None => Err(AppError::not_found("no outcome for that session")),
+    }
+}
+
 pub enum AppError {
     Bad(String),
     NotFound(String),
