# Issuer automation for the standing order (docs/privy-standing-order.md). Copy to automation/.env (gitignored).

# privy: the tick sends subscribe() from the investor's Privy embedded wallet through the delegated
#        signer; policies are created on the Privy app. Needs the four PRIVY_* values and a Sepolia RPC.
# local: the tick signs with LOCAL_INVESTOR_KEYS against anvil and applies the same rule JSON in a
#        small evaluator ("simulated Privy policy (local)"). Dev loop only, never in the video.
AUTOMATION_SIGNER=local

# Privy app (Dashboard: App settings). Never commit the real values.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Authorization key created under Wallet infrastructure > Authorization keys > Create new key:
# PRIVY_SIGNER_ID is the key quorum id shown in the modal (the same value as VITE_PRIVY_SIGNER_ID in app/.env),
# PRIVY_AUTHORIZATION_KEY is the private key from that modal (base64 PKCS8, with or without the "wallet-auth:" prefix).
PRIVY_SIGNER_ID=
PRIVY_AUTHORIZATION_KEY=

# Chain. Sepolia for privy mode; anvil for local mode.
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
REGISTRY=0x0000000000000000000000000000000000000000
SUBSCRIPTION=0x0000000000000000000000000000000000000000
# Optional: lets `POST /tick {"target":"fundToken"}` show a refusal by policy (wrong target).
FUND_TOKEN=
# Default when empty: keccak256("nachweis.pid.over18.v1")
POLICY_ID=
# First block the watcher reads Approved and Revoked from. Default: 0 in local mode, latest minus 5000 in privy mode.
START_BLOCK=
# How often the watcher polls the chain for Approved and Revoked (milliseconds). Shown on screen.
POLL_MS=4000

# local mode only: private keys of the wallets the automation may sign for (comma separated). Anvil key 1 by default.
LOCAL_INVESTOR_KEYS=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# HTTP server
PORT=8790
